generator client {
  provider = "prisma-client-js"
  // output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Sex {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum Role {
  ADMIN
  DOCTOR
  MEDICALASSISTANT
}

enum FormFieldValueType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

type FormFieldValue {
  id           String
  formFieldkey String
  value        String
}

model MedicalRecord {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  patient        Patient          @relation(fields: [patientId], references: [id])
  patientId      String           @db.ObjectId
  formFieldValue FormFieldValue[]
}

type Time {
  hour   Int
  minute Int
}

type AvailabilitySlot {
  startTime            Time
  endTime              Time
  appointmentTypes     AppointmentType[]
  appointmentReasonIds String[]
}

type TimeoffPeriod {
  startDate String
  endDate   String
}

type Availability {
  MONDAY         AvailabilitySlot[]
  TUESDAY        AvailabilitySlot[]
  WEDNESDAY      AvailabilitySlot[]
  THURSDAY       AvailabilitySlot[]
  FRIDAY         AvailabilitySlot[]
  SATURDAY       AvailabilitySlot[]
  SUNDAY         AvailabilitySlot[]
  timeOffPeriods TimeoffPeriod[]
}

model Doctor {
  id                      String                    @id @default(auto()) @map("_id") @db.ObjectId
  firstname               String
  lastname                String
  username                String                    @unique
  password                String
  email                   String?
  phoneNumber             String?
  // sex                     Sex
  speciality              String
  medicalAssistant        MedicalAssistant[]
  hospital                Hospital                  @relation(fields: [hospitalId], references: [id])
  hospitalId              String                    @db.ObjectId
  AppointmentReasonDoctor AppointmentReasonDoctor[]
  Appointment             Appointment[]
  role                    Role                      @default(DOCTOR)
}

model Patient {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  firstname     String
  lastname      String
  birthDate     DateTime
  maritalStatus MaritalStatus
  occupation    String?
  sex           Sex
  address       String
  phoneNumber   String
  medicalRecord MedicalRecord[]
  Appointment   Appointment[]
}

model MedicalAssistant {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  firstname   String
  lastname    String
  username    String
  password    String
  phoneNumber String?
  email       String?
  doctor      Doctor? @relation(fields: [doctorId], references: [id])
  doctorId    String? @db.ObjectId
  role        Role    @default(MEDICALASSISTANT)
}

model Hospital {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  address     String
  phoneNumber String
  doctor      Doctor[]
}

model Medicine {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
}

enum AppointmentType {
  IN_PERSON
  VIDEO_CALL
}

enum AppointmentStatus {
  PENDING
  SCHEDULED
  CANCELED
  COMPLETED
  IN_PROGRESS
}

model AppointmentReasonDoctor {
  id                  String            @id @default(auto()) @map("_id") @db.ObjectId
  appointmentReason   AppointmentReason @relation(fields: [appointmentReasonId], references: [id])
  appointmentReasonId String            @db.ObjectId
  doctor              Doctor            @relation(fields: [doctorId], references: [id])
  doctorId            String            @db.ObjectId
}

model AppointmentReason {
  id                       String                    @id @default(auto()) @map("_id") @db.ObjectId
  name                     String                    @unique
  description              String?
  price                    Float
  defaultDuration          Int?
  appointmentTypes         AppointmentType[]
  appointments             Appointment[]
  appointmentReasonsDoctor AppointmentReasonDoctor[]
}

type PrescriptionMedication {
  name     String
  posology String
}

type PrescriptionMedicalRest {
  startDate DateTime?
  endDate   DateTime?
}

type Prescription {
  type        PrescriptionType
  description String?
  note        String?
  medications PrescriptionMedication[]
  medicalRest PrescriptionMedicalRest?
  createdAt   DateTime                 @default(now())
}

model Appointment {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  date                DateTime
  endDate             DateTime?
  patient             Patient?           @relation(fields: [patientId], references: [id])
  patientId           String             @db.ObjectId
  appointmentType     AppointmentType
  observations        String?
  diagnostic          String?
  doctor              Doctor             @relation(fields: [doctorId], references: [id])
  doctorId            String             @db.ObjectId
  status              AppointmentStatus  @default(SCHEDULED)
  appointmentReason   AppointmentReason? @relation(fields: [appointmentReasonId], references: [id])
  appointmentReasonId String?            @db.ObjectId
  notes               AppointmentNote[]
  prescriptions       Prescription[]
  preConsultationInfo String?
}

type AppointmentNote {
  label             String?
  treatmentDuration Int?
  treatment         String?
  observations      String
}

enum PrescriptionType {
  MEDICATION
  RADIOGRAPHY
  MEDICAL_CERTIFICATE
}

model Admin {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  firstname String
  lastname  String
  username  String @unique
  password  String
  role      Role   @default(ADMIN)

}
